{
    "name": "FastDoc backend",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsup",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "lint": "eslint --fix"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.11",
        "@hono/zod-openapi": "^1.2.4",
        "@scalar/hono-api-reference": "^0.10.5",
        "dotenv": "^17.3.1",
        "groq-sdk": "^1.1.2",
        "hono": "^4.12.9",
        "lru-cache": "^11.3.6",
        "octokit": "^5.0.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^7.7.3",
        "@types/node": "^20.19.37",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.7.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}
