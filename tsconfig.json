{
    "compilerOptions": {
        "target": "ESNext",
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "baseUrl": ".",
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "outDir": "./dist",
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "*.config.ts"],
    "exclude": ["node_modules"]
}
